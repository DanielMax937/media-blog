# Copy to .env — Chrome DevTools MCP (local-service chrome-dev-mcp-server) for URL scraping
# CHROME_DEVTOOLS_MCP_URL=http://127.0.0.1:9223
# CDS_NAVIGATION_TIMEOUT_MS=120000
# FORCE_PLAYWRIGHT_SCRAPE=true

# Optional: bypass local webgemini for image generation and call Google AI directly.
# When enabled, requests MUST go through the configured proxy.
# GOOGLE_IMAGE_USE_DIRECT_API=true
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_PROXY_URL=http://127.0.0.1:7890
# GOOGLE_AI_IMAGE_MODEL=gemini-3-pro-image-preview
# GOOGLE_AI_API_VERSION=
# GOOGLE_AI_BASE_URL=

# Medium demo generation provider: `claude` or `openai`
# Defaults to `claude`
# MEDIUM_DEMO_PROVIDER=claude
