# Copy to .env — Chrome DevTools MCP (local-service chrome-dev-mcp-server) for URL scraping
# CHROME_DEVTOOLS_MCP_URL=http://127.0.0.1:9223
# CDS_NAVIGATION_TIMEOUT_MS=120000
# FORCE_PLAYWRIGHT_SCRAPE=true

# OpenAI-compatible chat endpoint.
# Leave OPENAI_MODEL empty to use the gateway default model (agent-im defaults to codex-login/gpt-5.5).
OPENAI_BASE_URL=http://127.0.0.1:3300/v1
OPENAI_API_KEY=unused
OPENAI_MODEL=

# Optional fallback path. Kept on the same gateway so LLM calls do not leave local agent-im.
FALLBACK_OPENAI_API_KEY=unused
FALLBACK_OPENAI_BASE_URL=http://127.0.0.1:3300/v1
FALLBACK_OPENAI_MODEL=codex-login/gpt-5.5
FALLBACK_ANTHROPIC_API_KEY=unused
FALLBACK_ANTHROPIC_BASE_URL=http://127.0.0.1:3300/v1
FALLBACK_ANTHROPIC_MODEL=codex-login/gpt-5.5

# Independent Google AI direct image settings (not used by Medium/XHS).
# When enabled, requests MUST go through the configured proxy.
# GOOGLE_IMAGE_USE_DIRECT_API=true
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_PROXY_URL=http://127.0.0.1:7890
# GOOGLE_AI_IMAGE_MODEL=gemini-3-pro-image-preview
# GOOGLE_AI_API_VERSION=
# GOOGLE_AI_BASE_URL=

# Native Codex image generation. Requires CLI 0.159.2-compatible app-server protocol
# and `codex login status` => Logged in using ChatGPT. No image API key is used.
# CODEX_IMAGE_CLI=/Users/caoxiaopeng/.npm-global/bin/codex
# CODEX_IMAGE_PROXY=http://127.0.0.1:1087
# CODEX_IMAGE_TIMEOUT_MS=900000
# Defaults to model/effort in CODEX_HOME/config.toml; optional overrides:
# CODEX_IMAGE_MODEL=gpt-6.1-sol
# CODEX_IMAGE_REASONING_EFFORT=ultra
# No automatic retries or fallback backend; see docs/codex-imagegen.md.

# Medium demo generation provider: `claude` or `openai`.
# Use `openai` to route demo generation through the OpenAI-compatible endpoint above.
MEDIUM_DEMO_PROVIDER=openai

# Astro Micro publishing for /medium generated MDX.
# Keep enabled to commit and push generated MDX so Vercel GitHub App deploys main automatically.
ASTRO_MICRO_BLOG_DIR=../astro-micro/src/content/blog
ASTRO_MICRO_SITE_URL=https://melin.vercel.app
ASTRO_MICRO_GIT_PUBLISH=true
ASTRO_MICRO_GIT_BRANCH=main
ASTRO_MICRO_GIT_REMOTE=origin
ASTRO_MICRO_GIT_AUTHOR_NAME=daniel1989
ASTRO_MICRO_GIT_AUTHOR_EMAIL=riyueniao2010@gmail.com
